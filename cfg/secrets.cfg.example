###############################################################################
#  secrets.cfg.example · template for secrets.cfg (gitignored)
#
#  Copy to `secrets.cfg` and fill in real values. Do NOT commit secrets.cfg.
###############################################################################

## Required ──────────────────────────────────────────────────────────────────

# Cfx.re license key — get one at https://keymaster.fivem.net
sv_licenseKey "REPLACE_ME"

# MySQL connection string — see https://coxdocs.dev/oxmysql#installation
set mysql_connection_string "mysql://user:password@localhost/dbname?charset=utf8mb4"


## Optional ──────────────────────────────────────────────────────────────────

# Steam Web API key — needed if you rely on Steam identifiers for anything
# beyond identity. Without this, Steam idents may show as empty for some
# users. https://steamcommunity.com/dev/apikey
# set steam_webApiKey "REPLACE_ME"

# Discord webhook for st_log warn/error forwarding. Empty = disabled.
# setr st:log:webhook "https://discord.com/api/webhooks/.../..."
